# === AboutFit — Environment Variables ===
# Copy this file to .env and fill in real values.

# ─── Database ───
DATABASE_URL="postgresql://aboutfit:aboutfit@localhost:5432/aboutfit?schema=public"

# ─── Redis ───
REDIS_URL="redis://localhost:6379"

# ─── Object Storage (MinIO for dev, OSS/R2 for prod) ───
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="aboutfit"
S3_SECRET_KEY="aboutfit-dev-secret"
S3_BUCKET_UPLOADS="about-fit-uploads"
S3_BUCKET_RENDERS="about-fit-renders"
S3_REGION="us-east-1"

# ─── AI Providers ───
# DashScope (阿里云通义 / 通义万相)
DASHSCOPE_API_KEY="your-dashscope-api-key"

# Doubao 即梦 (字节豆包)
JIMENG_API_KEY=""
JIMENG_ACCESS_KEY=""
JIMENG_SECRET_KEY=""

# OpenAI (fallback for copy generation)
OPENAI_API_KEY=""

# Replicate (SDXL + IP-Adapter fallback)
REPLICATE_API_TOKEN=""

# Fal.ai (video generation fallback)
FAL_KEY=""

# ─── Auth ───
AUTH_SECRET="generate-a-random-32-char-string-here"
AUTH_URL="http://localhost:3000"

# Email provider for magic link (Resend recommended)
AUTH_RESEND_KEY=""

# ─── App ───
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_PORT=4000
WORKER_CONCURRENCY=5

# ─── Provider Routing ───
# "CN" = prefer DashScope + 即梦 ; "OVERSEAS" = prefer OpenAI + Replicate
AI_REGION="CN"
